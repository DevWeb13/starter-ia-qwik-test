{
  "name": "cars-pat-qwik",
  "description": "Site vitrine Qwik de Cars Pat, carrosserie à Marseille Mazargues.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "dev": "vite --mode ssr",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "qwik": "qwik",
    "start": "vite --open --mode ssr",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc --incremental --noEmit"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.0",
    "@builder.io/qwik-city": "1.20.0",
    "@eslint/js": "9.32.0",
    "@playwright/test": "1.61.1",
    "@types/node": "20.19.0",
    "@types/three": "^0.185.3",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "1.20.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "4.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
